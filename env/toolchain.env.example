# 复制为未提交的文件，例如 ~/Work/eda-sandbox/toolchain.env，随后设置
# SYSTEMC_TLM_TOOLCHAIN_CONFIG=/绝对路径/toolchain.env。
# 所有值均应是单一可执行文件或 SDK 的绝对路径；没有空格参数包装需求。

# EDA_TOOL_SURELOG=/path/to/surelog
# EDA_TOOL_UHDM_LINT=/path/to/uhdm-lint
# EDA_TOOL_UHDM_HIER=/path/to/uhdm-hier
# EDA_TOOL_UHDM=/path/to/eda-uhdm
# EDA_TOOL_VCS=/path/to/vcs
# EDA_TOOL_CC=/usr/bin/cc
# EDA_TOOL_CMAKE=/usr/bin/cmake
# EDA_TOOL_CXX=/usr/bin/c++
# EDA_TOOL_CTEST=/usr/bin/ctest
# EDA_TOOL_NINJA=/usr/bin/ninja
# EDA_TOOL_PODMAN=/usr/bin/podman
# EDA_TOOL_PODMAN_COMPOSE=/usr/bin/podman-compose
# EDA_TOOL_DOCKER=/usr/bin/docker
# EDA_TOOL_UV=/path/to/uv

# EDA_SCC_HOME=/path/to/scc-sdk
# EDA_SCC_DEPS=/path/to/scc-dependencies
# EDA_SYSTEMC_HOME=/path/to/systemc
# VCS_HOME=/path/to/vcs-install
# CMAKE_PREFIX_PATH=/path/to/scc-sdk:/path/to/scc-dependencies
# CMAKE_MODULE_PATH=/path/to/conan-generators
# LD_LIBRARY_PATH=/path/to/sdk/lib:/path/to/dependencies/lib
