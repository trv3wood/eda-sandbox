{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eda-sandbox.local/schemas/eda-query-result-v1.json",
  "title": "EDA QueryResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "query_id", "backend", "kind", "selectors", "source",
    "status", "items", "warnings", "truncated", "next_offset"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "query_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend": {"enum": ["uhdm", "yosys", "verilator"]},
    "kind": {"type": "string", "minLength": 1},
    "selectors": {"type": "object"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "format": {"enum": ["uhdm-json", "yosys-json", "verilator-json"]}
      }
    },
    "status": {"enum": ["ok", "empty", "unsupported", "error"]},
    "items": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "truncated": {"type": "boolean"},
    "next_offset": {"type": ["integer", "null"], "minimum": 0}
  }
}
