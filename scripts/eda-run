#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${repo_root}/scripts/regress-common.sh"
load_toolchain_config

usage() {
  cat <<'EOF'
Usage:
  scripts/eda-run [OPTIONS] ROLE COMMAND [ARG...]
  scripts/eda-run [OPTIONS] ROLE --shell

Roles:
  agent       Local uv workflow and harness tooling
  vcs         Local commercial EDA commands（继承当前研发网许可证环境）
  uhdm        Surelog and direct UHDM Python queries
  rtl         RTL simulation and differential-test tooling
  scc         SystemC/SCC compilation and verification
  rocky       Rocky Linux 8 SystemC/minres-SCC SDK

Options:
  --work DIR       Work root; /workspace paths are translated for agent (default: current directory)
  --image IMAGE    Override the role's image
  --tag TAG        Image tag (default: EDA_IMAGE_TAG or main)
  --pull POLICY    never, missing, always, or newer (default: never)
  --shell          Run an interactive Bash shell
  -h, --help       Show this help

Environment:
  EDA_CONTAINER_ENGINE  podman or docker
  EDA_IMAGE_PREFIX      default: ghcr.io/trv3wood
  EDA_IMAGE_TAG         default: main
  EDA_UHDM_IMAGE, EDA_RTL_IMAGE, EDA_SCC_IMAGE, EDA_ROCKY_SCC_IMAGE
  EDA_ROCKY_IMAGE and EDA_ENTERPRISE_IMAGE remain supported as legacy aliases.

Examples:
  scripts/eda-run uhdm surelog --version
  scripts/eda-run --work workspace vcs vcs -f /workspace/project/top.f -top top
  scripts/eda-run --work workspace agent eda-harness discover /workspace/project
  scripts/eda-run uhdm eda-uhdm run /workspace/design.uhdm \
    /workspace/query.py --output-dir /workspace/query-output
  scripts/eda-run scc --shell
  scripts/eda-run rocky --shell
EOF
}

work_dir="${PWD}"
image_override=""
tag="${EDA_IMAGE_TAG:-main}"
pull_policy="never"
shell_mode=false

while (($#)); do
  case "$1" in
    --work)
      [[ $# -ge 2 ]] || { printf 'ERROR: --work requires a value\n' >&2; exit 2; }
      work_dir="$2"
      shift 2
      ;;
    --image)
      [[ $# -ge 2 ]] || { printf 'ERROR: --image requires a value\n' >&2; exit 2; }
      image_override="$2"
      shift 2
      ;;
    --tag)
      [[ $# -ge 2 ]] || { printf 'ERROR: --tag requires a value\n' >&2; exit 2; }
      tag="$2"
      shift 2
      ;;
    --pull)
      [[ $# -ge 2 ]] || { printf 'ERROR: --pull requires a value\n' >&2; exit 2; }
      pull_policy="$2"
      shift 2
      ;;
    --shell)
      shell_mode=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'ERROR: unknown option before ROLE: %s\n' "$1" >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

[[ $# -ge 1 ]] || { usage >&2; exit 2; }
role="$1"
shift
if [[ "${1:-}" == "--shell" ]]; then
  shell_mode=true
  shift
fi

case "${role}" in
  agent|vcs)
    ;;
  uhdm)
    role_image="${EDA_UHDM_IMAGE:-}"
    image_name="eda-uhdm"
    ;;
  rtl)
    role_image="${EDA_RTL_IMAGE:-}"
    image_name="eda-rtl"
    ;;
  scc)
    role_image="${EDA_SCC_IMAGE:-}"
    image_name="eda-scc"
    ;;
  rocky|enterprise)
    role_image="${EDA_ROCKY_IMAGE:-${EDA_ROCKY_SCC_IMAGE:-${EDA_ROCKY_SYSTEMC_IMAGE:-${EDA_ENTERPRISE_IMAGE:-}}}}"
    image_name="eda-scc-rocky8"
    ;;
  *)
    printf 'ERROR: unknown role: %s\n' "${role}" >&2
    exit 2
    ;;
esac

case "${pull_policy}" in
  never|missing|always|newer) ;;
  *)
    printf 'ERROR: invalid pull policy: %s\n' "${pull_policy}" >&2
    exit 2
    ;;
esac

work_dir="$(realpath "${work_dir}")"
[[ -d "${work_dir}" ]] || {
  printf 'ERROR: work directory does not exist: %s\n' "${work_dir}" >&2
  exit 2
}

if [[ "${role}" == "agent" || "${role}" == "vcs" ]]; then
  if [[ "${shell_mode}" == true ]]; then
    [[ $# -eq 0 ]] || {
      printf 'ERROR: --shell does not accept a command\n' >&2
      exit 2
    }
    exec "${SHELL:-/bin/bash}"
  fi
  [[ $# -ge 1 ]] || {
    printf 'ERROR: COMMAND is required unless --shell is used\n' >&2
    exit 2
  }
  local_args=()
  for argument in "$@"; do
    case "${argument}" in
      /workspace) local_args+=("${work_dir}") ;;
      /workspace/*) local_args+=("${work_dir}/${argument#/workspace/}") ;;
      *) local_args+=("${argument}") ;;
    esac
  done
  if [[ "${role}" == "agent" ]]; then
    uv_tool="$(tool_path EDA_TOOL_UV uv)"
    command -v "${uv_tool}" >/dev/null 2>&1 || {
      printf 'ERROR: uv is required for the local agent role; run uv sync\n' >&2
      exit 1
    }
    exec "${uv_tool}" run --project "${repo_root}" -- "${local_args[@]}"
  fi
  exec "${local_args[@]}"
fi

image="${image_override:-${role_image:-${EDA_IMAGE_PREFIX:-ghcr.io/trv3wood}/${image_name}:${tag}}}"
engine="${EDA_CONTAINER_ENGINE:-}"
if [[ -z "${engine}" ]]; then
  if command -v "$(tool_path EDA_TOOL_PODMAN podman)" >/dev/null 2>&1; then
    engine="$(tool_path EDA_TOOL_PODMAN podman)"
  elif command -v "$(tool_path EDA_TOOL_DOCKER docker)" >/dev/null 2>&1; then
    engine="$(tool_path EDA_TOOL_DOCKER docker)"
  else
    printf 'ERROR: neither podman nor docker is available\n' >&2
    exit 1
  fi
fi
if [[ "${engine}" == "podman" ]]; then
  engine="$(tool_path EDA_TOOL_PODMAN podman)"
elif [[ "${engine}" == "docker" ]]; then
  engine="$(tool_path EDA_TOOL_DOCKER docker)"
fi
command -v "${engine}" >/dev/null 2>&1 || {
  printf 'ERROR: container engine is unavailable: %s\n' "${engine}" >&2
  exit 1
}

container_args=(run --rm --pull="${pull_policy}" -w /workspace)
if [[ "${engine##*/}" == "podman" ]]; then
  container_args+=(--userns=keep-id -v "${work_dir}:/workspace:Z")
else
  container_args+=(--user "$(id -u):$(id -g)" -v "${work_dir}:/workspace")
fi

if [[ "${shell_mode}" == true ]]; then
  [[ $# -eq 0 ]] || {
    printf 'ERROR: --shell does not accept a command\n' >&2
    exit 2
  }
  container_args+=(-it "${image}" /bin/bash)
else
  [[ $# -ge 1 ]] || {
    printf 'ERROR: COMMAND is required unless --shell is used\n' >&2
    exit 2
  }
  if [[ -t 0 && -t 1 ]]; then
    container_args+=(-it)
  fi
  container_args+=("${image}" "$@")
fi

exec "${engine}" "${container_args[@]}"
