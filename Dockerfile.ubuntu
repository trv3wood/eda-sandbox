FROM ubuntu:24.04 AS ubuntu-base

ENV DEBIAN_FRONTEND=noninteractive TZ=UTC
WORKDIR /workspace

# Lightweight workflow/benchmark image. It intentionally contains no EDA or
# SystemC compiler toolchain.
FROM ubuntu-base AS agent
ARG IMAGE_REVISION=unknown
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*
COPY pyproject.toml /opt/systemc-agent/
COPY src /opt/systemc-agent/src
COPY scripts/regress.sh /opt/systemc-agent/scripts/regress.sh
RUN python3 -m pip install --break-system-packages --no-cache-dir /opt/systemc-agent
ENV IMAGE_REVISION=${IMAGE_REVISION}
CMD ["/bin/bash"]

# Binary Surelog and UHDM runtime. The conda UHDM package does not include its
# optional SWIG wrapper, which is added in the next disposable builder.
FROM ubuntu-base AS uhdm-runtime
ARG MICROMAMBA_VERSION=2.6.2-1
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
COPY env/uhdm-environment.yml /tmp/uhdm-environment.yml
RUN curl -fsSL \
        "https://github.com/mamba-org/micromamba-releases/releases/download/${MICROMAMBA_VERSION}/micromamba-linux-64" \
        -o /usr/local/bin/micromamba && \
    chmod 0755 /usr/local/bin/micromamba && \
    micromamba create --yes --prefix /opt/conda/envs/uhdm \
        --file /tmp/uhdm-environment.yml && \
    micromamba clean --all --yes && \
    rm -f /tmp/uhdm-environment.yml

FROM uhdm-runtime AS uhdm-python-builder
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential cmake git ninja-build python3-dev swig && \
    rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v1.84 --recurse-submodules \
        --shallow-submodules \
        https://github.com/chipsalliance/UHDM.git /tmp/uhdm-src
RUN cmake -S /tmp/uhdm-src -B /tmp/uhdm-build -G Ninja \
        -DUHDM_WITH_PYTHON=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH=/opt/conda/envs/uhdm \
        -DPython3_EXECUTABLE=/opt/conda/envs/uhdm/bin/python \
        -DCMAKE_INSTALL_PREFIX=/opt/conda/envs/uhdm && \
    cmake --build /tmp/uhdm-build --parallel && \
    cmake --install /tmp/uhdm-build
RUN /opt/conda/envs/uhdm/bin/python -c "import uhdm; print(uhdm.Serializer)"
COPY tools/uhdm_export/main.cpp /tmp/uhdm-export.cpp
RUN mkdir -p /opt/eda-tools && \
    g++ -std=c++17 -O2 \
        -I/opt/conda/envs/uhdm/include \
        /tmp/uhdm-export.cpp \
        -L/opt/conda/envs/uhdm/lib -luhdm \
        -Wl,-rpath,/opt/conda/envs/uhdm/lib \
        -o /opt/eda-tools/uhdm-export && \
    LD_LIBRARY_PATH=/opt/conda/envs/uhdm/lib \
        /opt/eda-tools/uhdm-export --version

FROM ubuntu-base AS eda-uhdm
ARG IMAGE_REVISION=unknown
COPY --from=uhdm-python-builder /opt/conda/envs/uhdm /opt/conda/envs/uhdm
COPY --from=uhdm-python-builder /opt/eda-tools/uhdm-export /usr/local/bin/uhdm-export
COPY pyproject.toml /opt/systemc-agent/
COPY src /opt/systemc-agent/src
COPY scripts/regress.sh /opt/systemc-agent/scripts/regress.sh
RUN /opt/conda/envs/uhdm/bin/python -m pip install --no-deps /opt/systemc-agent
ENV MAMBA_ROOT_PREFIX=/opt/conda \
    PATH=/opt/conda/envs/uhdm/bin:/usr/local/bin:/usr/bin \
    LD_LIBRARY_PATH=/opt/conda/envs/uhdm/lib \
    IMAGE_REVISION=${IMAGE_REVISION}
RUN python3 -c "import uhdm; print(uhdm.Serializer)"
RUN uhdm-export --version
CMD ["/bin/bash"]

# Verilator/Yosys are independent from the semantic UHDM producer.
FROM ubuntu-base AS rtl-tools
ARG MICROMAMBA_VERSION=2.6.2-1
ARG IMAGE_REVISION=unknown
ENV MAMBA_ROOT_PREFIX=/opt/conda \
    PATH=/opt/conda/envs/rtl/bin:/usr/local/bin:/usr/bin \
    IMAGE_REVISION=${IMAGE_REVISION}
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
COPY env/rtl-environment.yml /tmp/rtl-environment.yml
RUN curl -fsSL \
        "https://github.com/mamba-org/micromamba-releases/releases/download/${MICROMAMBA_VERSION}/micromamba-linux-64" \
        -o /usr/local/bin/micromamba && \
    chmod 0755 /usr/local/bin/micromamba && \
    micromamba create --yes --prefix /opt/conda/envs/rtl \
        --file /tmp/rtl-environment.yml && \
    micromamba clean --all --yes && \
    rm -f /tmp/rtl-environment.yml
COPY pyproject.toml /opt/systemc-agent/
COPY src /opt/systemc-agent/src
COPY scripts/regress.sh /opt/systemc-agent/scripts/regress.sh
RUN python3 -m pip install --no-deps /opt/systemc-agent
CMD ["/bin/bash"]

# SCC/Conan compilation is a cacheable target. Keep runtime assembly below it
# so a failed copy cannot discard the expensive dependency and SCC builds.
FROM ubuntu-base AS scc-compile
ARG SCC_VERSION=2026.05
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git ninja-build python3 \
        python3-pip python3-venv && \
    rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/conan && \
    /opt/conan/bin/pip install --no-cache-dir conan
RUN git clone --depth 1 --recurse-submodules --shallow-submodules \
        --branch "${SCC_VERSION}" \
        https://github.com/Minres/SystemC-Components.git /tmp/scc-src
RUN cd /tmp/scc-src && \
    /opt/conan/bin/conan profile detect --force && \
    /opt/conan/bin/conan install . \
        --output-folder=/tmp/scc-conan \
        --deployer=full_deploy \
        --build=missing -s build_type=Release
RUN cd /tmp/scc-src && \
    cmake -S . -B /tmp/scc-build -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE=/tmp/scc-conan/build/Release/generators/conan_toolchain.cmake \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/scc && \
    cmake --build /tmp/scc-build --parallel && \
    cmake --install /tmp/scc-build

FROM scc-compile AS scc-builder
# Conan full_deploy omits SystemC's CMake package configuration. Its headers
# and libraries remain the runtime source; copy only configuration from cache.
RUN ( \
        echo "SCC copy: merging Conan full_deploy package roots" >&2 && \
        mkdir -p /opt/scc-deps && \
        for package_root in /tmp/scc-conan/full_deploy/host/*/*/*/*; do \
            test -d "${package_root}" || exit 1; \
            echo "SCC copy: ${package_root} -> /opt/scc-deps" >&2; \
            cp -a "${package_root}/." /opt/scc-deps/ || exit 1; \
        done && \
        echo "SCC copy: locating SystemCLanguage CMake package" >&2 && \
        systemc_config="$(find /root/.conan2/p \
            -type f \
            -name SystemCLanguageConfig.cmake \
            -print -quit)" && \
        test -n "${systemc_config}" && \
        systemc_cmake_dir="$(dirname "${systemc_config}")" && \
        echo "SCC copy: CMake source is ${systemc_cmake_dir}" >&2 && \
        mkdir -p /opt/scc-deps/lib/cmake/SystemCLanguage && \
        for cmake_file in "${systemc_cmake_dir}"/*.cmake; do \
            test -f "${cmake_file}" || exit 1; \
            cp -vL "${cmake_file}" \
                /opt/scc-deps/lib/cmake/SystemCLanguage/ || exit 1; \
        done && \
        for required_file in \
            SystemCLanguageConfig.cmake \
            SystemCLanguageConfigVersion.cmake \
            SystemCLanguageTargets.cmake \
            SystemCLanguageTargets-release.cmake; do \
            test -f "/opt/scc-deps/lib/cmake/SystemCLanguage/${required_file}" \
                || exit 1; \
        done && \
        echo "SCC copy: runtime dependency assembly completed" >&2 \
    ) || { \
        status=$?; \
        echo "ERROR: SCC runtime dependency copy failed (exit ${status})" >&2; \
        echo "--- Conan full_deploy package roots ---" >&2; \
        find /tmp/scc-conan/full_deploy/host -mindepth 4 -maxdepth 4 \
            -type d -printf '%y %p -> %l\n' 2>&1 | sort >&2; \
        echo "--- Deployed SystemC library entries ---" >&2; \
        find /tmp/scc-conan/full_deploy/host/systemc -maxdepth 7 \
            -path '*/lib/*' \
            -printf '%y %p -> %l\n' 2>&1 | sort >&2; \
        echo "--- Conan cache SystemCLanguage CMake files ---" >&2; \
        find /root/.conan2/p \
            -type f -name 'SystemCLanguage*.cmake' \
            -printf '%y %p -> %l\n' \
            2>&1 | sort >&2; \
        echo "--- Copied SCC library/CMake layout ---" >&2; \
        find /opt/scc-deps/lib -maxdepth 4 -printf '%y %p -> %l\n' \
            2>&1 | sort >&2; \
        exit "${status}"; \
    }

FROM ubuntu-base AS eda-scc
ARG IMAGE_REVISION=unknown
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*
COPY --from=scc-builder /opt/scc /opt/scc
COPY --from=scc-builder /opt/scc-deps /opt/scc-deps
COPY pyproject.toml /opt/systemc-agent/
COPY src /opt/systemc-agent/src
COPY scripts/regress.sh /opt/systemc-agent/scripts/regress.sh
RUN python3 -m pip install --break-system-packages --no-cache-dir /opt/systemc-agent
ENV PATH=/opt/scc/bin:/usr/local/bin:/usr/bin \
    CMAKE_PREFIX_PATH=/opt/scc:/opt/scc-deps \
    LD_LIBRARY_PATH=/opt/scc/lib:/opt/scc-deps/lib \
    IMAGE_REVISION=${IMAGE_REVISION}
RUN test -f \
    /opt/scc-deps/lib/cmake/SystemCLanguage/SystemCLanguageConfig.cmake
CMD ["/bin/bash"]
