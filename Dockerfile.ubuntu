FROM ubuntu:24.04 AS ubuntu-base

ENV DEBIAN_FRONTEND=noninteractive TZ=UTC
WORKDIR /workspace

# Binary Surelog and UHDM runtime. The conda UHDM package does not include its
# optional SWIG wrapper, which is added in the next disposable builder.
FROM ubuntu-base AS uhdm-runtime
ARG MICROMAMBA_VERSION=2.6.2-1
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
COPY env/uhdm-environment.yml /tmp/uhdm-environment.yml
RUN curl -fsSL \
        "https://github.com/mamba-org/micromamba-releases/releases/download/${MICROMAMBA_VERSION}/micromamba-linux-64" \
        -o /usr/local/bin/micromamba && \
    chmod 0755 /usr/local/bin/micromamba && \
    micromamba create --yes --prefix /opt/conda/envs/uhdm \
        --file /tmp/uhdm-environment.yml && \
    micromamba clean --all --yes && \
    rm -f /tmp/uhdm-environment.yml

FROM uhdm-runtime AS uhdm-python-builder
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential cmake git ninja-build python3-dev swig && \
    rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v1.84 --recurse-submodules \
        --shallow-submodules \
        https://github.com/chipsalliance/UHDM.git /tmp/uhdm-src
RUN cmake -S /tmp/uhdm-src -B /tmp/uhdm-build -G Ninja \
        -DUHDM_WITH_PYTHON=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH=/opt/conda/envs/uhdm \
        -DPython3_EXECUTABLE=/opt/conda/envs/uhdm/bin/python \
        -DCMAKE_INSTALL_PREFIX=/opt/conda/envs/uhdm && \
    cmake --build /tmp/uhdm-build --parallel && \
    cmake --install /tmp/uhdm-build
RUN /opt/conda/envs/uhdm/bin/python -c "import uhdm; print(uhdm.Serializer)"

FROM ubuntu-base AS eda-uhdm
ARG IMAGE_REVISION=unknown
COPY --from=uhdm-python-builder /opt/conda/envs/uhdm /opt/conda/envs/uhdm
COPY pyproject.toml /opt/systemc-agent/
COPY src /opt/systemc-agent/src
COPY scripts/regress*.sh /opt/systemc-agent/scripts/
RUN /opt/conda/envs/uhdm/bin/python -m pip install --no-deps /opt/systemc-agent
ENV MAMBA_ROOT_PREFIX=/opt/conda \
    PATH=/opt/conda/envs/uhdm/bin:/usr/local/bin:/usr/bin \
    EDA_TOOL_SURELOG=/opt/conda/envs/uhdm/bin/surelog \
    EDA_TOOL_UHDM_LINT=/opt/conda/envs/uhdm/bin/uhdm-lint \
    EDA_TOOL_UHDM_HIER=/opt/conda/envs/uhdm/bin/uhdm-hier \
    EDA_TOOL_UHDM=/opt/conda/envs/uhdm/bin/eda-uhdm \
    LD_LIBRARY_PATH=/opt/conda/envs/uhdm/lib \
    IMAGE_REVISION=${IMAGE_REVISION}
RUN python3 -c "import uhdm; print(uhdm.Serializer)"
RUN eda-uhdm version
CMD ["/bin/bash"]

# SCC/Conan compilation is a cacheable target. Keep runtime assembly below it
# so a failed copy cannot discard the expensive dependency and SCC builds.
FROM ubuntu-base AS scc-compile
ARG SCC_VERSION=2026.05
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git ninja-build python3 \
        python3-pip python3-venv && \
    rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/conan && \
    /opt/conan/bin/pip install --no-cache-dir conan
RUN git clone --depth 1 --recurse-submodules --shallow-submodules \
        --branch "${SCC_VERSION}" \
        https://github.com/Minres/SystemC-Components.git /tmp/scc-src
RUN cd /tmp/scc-src && \
    /opt/conan/bin/conan profile detect --force && \
    /opt/conan/bin/conan install . \
        --output-folder=/tmp/scc-conan \
        --deployer=full_deploy \
        --build=missing -s build_type=Release
RUN cd /tmp/scc-src && \
    cmake -S . -B /tmp/scc-build -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE=/tmp/scc-conan/build/Release/generators/conan_toolchain.cmake \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/scc && \
    cmake --build /tmp/scc-build --parallel && \
    cmake --install /tmp/scc-build

FROM scc-compile AS scc-builder
# Keep Conan's deployed runtime libraries, then use SystemC's own CMake install
# script to create a complete, relocatable CMake package configuration.
RUN set -eu; \
    echo "SCC deploy: merging Conan full_deploy package roots" >&2; \
    mkdir -p /opt/scc-deps; \
    package_count=0; \
    for package_root in /tmp/scc-conan/full_deploy/host/*/*/*/*; do \
        if [ ! -d "${package_root}" ]; then \
            echo "ERROR: expected Conan package root is missing: ${package_root}" >&2; \
            exit 1; \
        fi; \
        package_count=$((package_count + 1)); \
        echo "SCC deploy: ${package_root} -> /opt/scc-deps" >&2; \
        cp -a "${package_root}/." /opt/scc-deps/; \
    done; \
    if [ "${package_count}" -eq 0 ]; then \
        echo "ERROR: no Conan package roots were deployed" >&2; \
        exit 1; \
    fi
RUN set -eu; \
    echo "SCC install: locating SystemC CMake build tree" >&2; \
    systemc_config="$(find /root/.conan2/p -type f \
        -path '*/build/Release/SystemCLanguageConfig.cmake' -print -quit)"; \
    if [ -z "${systemc_config}" ]; then \
        echo "ERROR: SystemCLanguageConfig.cmake was not found in the Conan build tree" >&2; \
        find /root/.conan2/p -type f -path '*/build/Release/*SystemC*.cmake' \
            -printf '%p\n' 2>&1 | sort >&2; \
        exit 1; \
    fi; \
    systemc_build_dir="$(dirname "${systemc_config}")"; \
    if [ ! -f "${systemc_build_dir}/cmake_install.cmake" ]; then \
        echo "ERROR: SystemC install script is missing: ${systemc_build_dir}/cmake_install.cmake" >&2; \
        exit 1; \
    fi; \
    echo "SCC install: ${systemc_build_dir} -> /opt/scc-deps" >&2; \
    cmake --install "${systemc_build_dir}" --prefix /opt/scc-deps
# Conan full_deploy 只部署这些包的头文件和静态库，但 SCC/lwtr 的导出
# 要求 CMake Config。为全部公开依赖生成可重定位兼容包，避免逐个补洞。
RUN set -eu; \
    for required_file in \
        include/lz4.h \
        include/fmt/format.h \
        include/spdlog/spdlog.h \
        include/yaml-cpp/yaml.h \
        include/backtrace.h \
        include/lzma.h \
        include/zlib.h \
        include/zstd.h \
        lib/liblz4.a \
        lib/libfmt.a \
        lib/libspdlog.a \
        lib/libyaml-cpp.a \
        lib/libbacktrace.a \
        lib/liblzma.a \
        lib/libz.a \
        lib/libzstd.a; do \
        test -f "/opt/scc-deps/${required_file}" || { \
            echo "ERROR: missing deployed dependency file: ${required_file}" >&2; \
            exit 1; \
        }; \
    done; \
    mkdir -p \
        /opt/scc-deps/lib/cmake/lz4 \
        /opt/scc-deps/lib/cmake/fmt \
        /opt/scc-deps/lib/cmake/spdlog \
        /opt/scc-deps/lib/cmake/yaml-cpp \
        /opt/scc-deps/lib/cmake/libbacktrace \
        /opt/scc-deps/lib/cmake/zstd; \
    printf '%s\n' \
        'get_filename_component(_lz4_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)' \
        'if(NOT TARGET LZ4::lz4_static)' \
        '  add_library(LZ4::lz4_static STATIC IMPORTED)' \
        '  set_target_properties(LZ4::lz4_static PROPERTIES' \
        '    IMPORTED_LOCATION "${_lz4_prefix}/lib/liblz4.a"' \
        '    INTERFACE_INCLUDE_DIRECTORIES "${_lz4_prefix}/include")' \
        'endif()' \
        'if(NOT TARGET lz4::lz4)' \
        '  add_library(lz4::lz4 INTERFACE IMPORTED)' \
        '  set_target_properties(lz4::lz4 PROPERTIES' \
        '    INTERFACE_LINK_LIBRARIES LZ4::lz4_static)' \
        'endif()' \
        'unset(_lz4_prefix)' \
        > /opt/scc-deps/lib/cmake/lz4/lz4-config.cmake; \
    printf '%s\n' \
        'get_filename_component(_fmt_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)' \
        'if(NOT TARGET fmt::fmt)' \
        '  add_library(fmt::fmt STATIC IMPORTED)' \
        '  set_target_properties(fmt::fmt PROPERTIES' \
        '    IMPORTED_LOCATION "${_fmt_prefix}/lib/libfmt.a"' \
        '    INTERFACE_INCLUDE_DIRECTORIES "${_fmt_prefix}/include")' \
        'endif()' \
        'if(NOT TARGET fmt::fmt-header-only)' \
        '  add_library(fmt::fmt-header-only INTERFACE IMPORTED)' \
        '  set_target_properties(fmt::fmt-header-only PROPERTIES' \
        '    INTERFACE_INCLUDE_DIRECTORIES "${_fmt_prefix}/include")' \
        'endif()' \
        'unset(_fmt_prefix)' \
        > /opt/scc-deps/lib/cmake/fmt/fmt-config.cmake; \
    printf '%s\n' \
        'include(CMakeFindDependencyMacro)' \
        'find_dependency(fmt CONFIG REQUIRED)' \
        'get_filename_component(_spdlog_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)' \
        'if(NOT TARGET spdlog::spdlog)' \
        '  add_library(spdlog::spdlog STATIC IMPORTED)' \
        '  set_target_properties(spdlog::spdlog PROPERTIES' \
        '    IMPORTED_LOCATION "${_spdlog_prefix}/lib/libspdlog.a"' \
        '    INTERFACE_INCLUDE_DIRECTORIES "${_spdlog_prefix}/include"' \
        '    INTERFACE_COMPILE_DEFINITIONS "SPDLOG_COMPILED_LIB;SPDLOG_FMT_EXTERNAL"' \
        '    INTERFACE_LINK_LIBRARIES fmt::fmt)' \
        'endif()' \
        'if(NOT TARGET spdlog::spdlog_header_only)' \
        '  add_library(spdlog::spdlog_header_only INTERFACE IMPORTED)' \
        '  set_target_properties(spdlog::spdlog_header_only PROPERTIES' \
        '    INTERFACE_INCLUDE_DIRECTORIES "${_spdlog_prefix}/include"' \
        '    INTERFACE_LINK_LIBRARIES fmt::fmt)' \
        'endif()' \
        'unset(_spdlog_prefix)' \
        > /opt/scc-deps/lib/cmake/spdlog/spdlog-config.cmake; \
    printf '%s\n' \
        'get_filename_component(_yaml_cpp_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)' \
        'if(NOT TARGET yaml-cpp::yaml-cpp)' \
        '  add_library(yaml-cpp::yaml-cpp STATIC IMPORTED)' \
        '  set_target_properties(yaml-cpp::yaml-cpp PROPERTIES' \
        '    IMPORTED_LOCATION "${_yaml_cpp_prefix}/lib/libyaml-cpp.a"' \
        '    INTERFACE_INCLUDE_DIRECTORIES "${_yaml_cpp_prefix}/include")' \
        'endif()' \
        'unset(_yaml_cpp_prefix)' \
        > /opt/scc-deps/lib/cmake/yaml-cpp/yaml-cpp-config.cmake; \
    printf '%s\n' \
        'get_filename_component(_libbacktrace_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)' \
        'if(NOT TARGET libbacktrace::libbacktrace)' \
        '  add_library(libbacktrace::libbacktrace STATIC IMPORTED)' \
        '  set_target_properties(libbacktrace::libbacktrace PROPERTIES' \
        '    IMPORTED_LOCATION "${_libbacktrace_prefix}/lib/libbacktrace.a"' \
        '    INTERFACE_INCLUDE_DIRECTORIES "${_libbacktrace_prefix}/include"' \
        '    INTERFACE_LINK_LIBRARIES "${CMAKE_DL_LIBS}")' \
        'endif()' \
        'unset(_libbacktrace_prefix)' \
        > /opt/scc-deps/lib/cmake/libbacktrace/libbacktrace-config.cmake; \
    printf '%s\n' \
        'get_filename_component(_zstd_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)' \
        'if(NOT TARGET zstd::libzstd_static)' \
        '  add_library(zstd::libzstd_static STATIC IMPORTED)' \
        '  set_target_properties(zstd::libzstd_static PROPERTIES' \
        '    IMPORTED_LOCATION "${_zstd_prefix}/lib/libzstd.a"' \
        '    INTERFACE_INCLUDE_DIRECTORIES "${_zstd_prefix}/include")' \
        'endif()' \
        'unset(_zstd_prefix)' \
        > /opt/scc-deps/lib/cmake/zstd/zstd-config.cmake; \
    echo "SCC install: generated relocatable dependency configs"; \
    find /opt/scc-deps/lib/cmake -maxdepth 2 -type f \
        \( -name '*-config.cmake' -o -name '*Config.cmake' \) -print | sort
# SCC 2026.05 的导出 target 公开引用了 BZip2、ZLIB、LibLZMA、zstd 和
# Boost stacktrace，但 scc-config.cmake 漏掉了这些依赖与 libbacktrace 传递链接。
RUN set -eu; \
    scc_config=/opt/scc/lib/cmake/scc/scc-config.cmake; \
    test -f "${scc_config}"; \
    grep -nF 'find_dependency(Boost COMPONENTS date_time filesystem)' "${scc_config}"; \
    sed -i \
        's/find_dependency(Boost COMPONENTS date_time filesystem)/find_dependency(BZip2 REQUIRED)\nfind_dependency(ZLIB REQUIRED)\nfind_dependency(LibLZMA REQUIRED)\nfind_dependency(libbacktrace CONFIG REQUIRED)\nfind_dependency(zstd CONFIG REQUIRED)\nfind_dependency(Boost COMPONENTS date_time filesystem stacktrace_backtrace)\nset_property(TARGET Boost::stacktrace_backtrace APPEND PROPERTY INTERFACE_LINK_LIBRARIES libbacktrace::libbacktrace)/' \
        "${scc_config}"; \
    echo "SCC install: patched exported dependency closure"; \
    grep -nE 'BZip2|ZLIB|LibLZMA|libbacktrace|zstd|Boost.*stacktrace' "${scc_config}"
RUN set -eu; \
    echo "SCC verify: checking SystemCLanguage CMake export" >&2; \
    for required_file in \
        SystemCLanguageConfig.cmake \
        SystemCLanguageConfigVersion.cmake \
        SystemCLanguageTargets.cmake \
        SystemCLanguageTargets-release.cmake; do \
        required_path="/opt/scc-deps/lib/cmake/SystemCLanguage/${required_file}"; \
        if [ ! -f "${required_path}" ]; then \
            echo "ERROR: missing SystemC CMake export: ${required_path}" >&2; \
            find /opt/scc-deps/lib/cmake -maxdepth 3 -type f -printf '%p\n' \
                2>&1 | sort >&2 || true; \
            exit 1; \
        fi; \
        echo "SCC verify: found ${required_path}" >&2; \
    done

FROM ubuntu-base AS eda-scc
ARG IMAGE_REVISION=unknown
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*
COPY --from=scc-builder /opt/scc /opt/scc
COPY --from=scc-builder /opt/scc-deps /opt/scc-deps
COPY pyproject.toml /opt/systemc-agent/
COPY src /opt/systemc-agent/src
COPY scripts/regress*.sh /opt/systemc-agent/scripts/
# 最终 SDK 仅复制部署产物；Conan CMakeDeps 的 build/generators 目录不是
# 稳定交付接口。Boost 必须由部署后的头文件和库通过 FindBoost 发现。
RUN python3 -m pip install --break-system-packages --no-cache-dir /opt/systemc-agent
ENV PATH=/opt/scc/bin:/usr/local/bin:/usr/bin \
    EDA_TOOL_CMAKE=/usr/bin/cmake \
    EDA_TOOL_CXX=/usr/bin/c++ \
    EDA_TOOL_CTEST=/usr/bin/ctest \
    EDA_TOOL_NINJA=/usr/bin/ninja \
    EDA_CXX_STANDARD=17 \
    EDA_SCC_HOME=/opt/scc \
    EDA_SCC_DEPS=/opt/scc-deps \
    CMAKE_PREFIX_PATH=/opt/scc:/opt/scc-deps \
    LD_LIBRARY_PATH=/opt/scc/lib:/opt/scc-deps/lib \
    IMAGE_REVISION=${IMAGE_REVISION}
RUN test -f \
    /opt/scc-deps/lib/cmake/SystemCLanguage/SystemCLanguageConfig.cmake && \
    test -f /opt/scc-deps/lib/cmake/lz4/lz4-config.cmake && \
    test -f /opt/scc-deps/lib/cmake/fmt/fmt-config.cmake && \
    test -f /opt/scc-deps/lib/cmake/spdlog/spdlog-config.cmake && \
    test -f /opt/scc-deps/lib/cmake/yaml-cpp/yaml-cpp-config.cmake && \
    test -f /opt/scc-deps/lib/cmake/libbacktrace/libbacktrace-config.cmake && \
    test -f /opt/scc-deps/lib/cmake/zstd/zstd-config.cmake
CMD ["/bin/bash"]
